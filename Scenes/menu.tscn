[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://addons/gecs/ecs/world.gd" id="2_world"]
[ext_resource type="FontFile" path="res://Fonts/Enchanted Land.otf" id="3_font"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_fonts/font = ExtResource("3_font")
script = ExtResource("1_menu")

[node name="World" type="Node" parent="."]
script = ExtResource("2_world")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.03529412, 0.03529412, 0.043137256, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="GameOver" type="Label" parent="Center/Content"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.9372549, 0.26666668, 0.26666668, 1)
theme_override_font_sizes/font_size = 64
text = "Game over"
horizontal_alignment = 1

[node name="Play" type="Button" parent="Center/Content"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Start"
